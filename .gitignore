# ==============================================================================
# Hospital Operations & Readmission Intelligence System - .gitignore
# ==============================================================================

# Local SQLite databases (rebuild locally with: python src/database.py)
/hospital.db
/hospital_uci.db
*.db
*.sqlite
*.sqlite3

# Backups & local archives
backup/
backup/**/*
*.bak

# Logs, diagnostics, and temporary files
*.log
*.tmp
*.temp

# Python byte-code, compilations, and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# Environment variables & secrets
.env
.env.local
.env.*
.streamlit/secrets.toml

# Streamlit runtime artifacts
.streamlit/*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE, Editor, and OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Download archives, temporary artifacts, and processed cache
data/raw/*.zip
data/raw/*.tar.gz
data/raw/*.gz
data/processed/*
!data/processed/.gitkeep
